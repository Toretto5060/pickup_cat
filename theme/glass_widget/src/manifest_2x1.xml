        <Text x="#padX+#rowPad+184*#u" y="#padTop+#titleH+0*(#rowH+#gap)+#rowH-23*#u" width="#cardW-2*#rowPad-184*#u"
              size="17*#u" color="@secondaryInk" fontFamily="mipro-regular" ellipsis="true"
              textExp="@pc_addr5"/>
        <Rectangle x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2" w="#btnW" h="#btnH"
                   cornerRadius="12" cornerRadiusExp="12*#u" fillColor="@pickBg"/>
        <Text x="#padX+#cardW-#rowPad-#btnW/2" y="#padTop+#titleH+0*(#rowH+#gap)+#rowH/2"
              align="center" alignV="center" size="20*#u" color="#FFFFFFFF"
              fontFamily="mipro-demibold" textExp="'取'"/>
      </Group>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(-2.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@secondaryInk" visibility="ifelse(#pc_rows_shown==1 || #pc_rows_shown==2 || #pc_rows_shown==3 || #pc_rows_shown==4 || #pc_rows_shown==5,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(-2.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@countRed" visibility="ifelse(#page==0,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(-1.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@secondaryInk" visibility="ifelse(#pc_rows_shown==2 || #pc_rows_shown==3 || #pc_rows_shown==4 || #pc_rows_shown==5,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(-1.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@countRed" visibility="ifelse(#page==1,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(0.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@secondaryInk" visibility="ifelse(#pc_rows_shown==3 || #pc_rows_shown==4 || #pc_rows_shown==5,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(0.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@countRed" visibility="ifelse(#page==2,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(1.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@secondaryInk" visibility="ifelse(#pc_rows_shown==4 || #pc_rows_shown==5,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(1.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@countRed" visibility="ifelse(#page==3,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(2.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@secondaryInk" visibility="ifelse(#pc_rows_shown==5,1,0)"/>
      <Rectangle x="#view_width-18*#u-3*#u" y="#view_height/2+(2.0)*16*#u-3*#u" w="6*#u" h="6*#u" cornerRadiusExp="3*#u" fillColor="@countRed" visibility="ifelse(#page==4,1,0)"/>
      <!-- 翻页层：只捕获上下滑动手势翻页，不挂 up。
           openApp 与「我已取件」按钮都在本层之上的独立图层，
           二者矩形零重叠，点按不会互相连带。 -->
      <Button x="0" y="0" w="#view_width" h="#view_height">
        <Triggers>
          <Trigger action="onFling"><VariableCommand name="page" expression="ifelse(#page==4,0,#page+1)"/></Trigger>
        </Triggers>
      </Button>
            <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2" w="#btnW" h="#btnH" interceptTouch="true" visibility="ifelse(#page==0 ** (#pc_rows_shown==1 || #pc_rows_shown==2 || #pc_rows_shown==3 || #pc_rows_shown==4 || #pc_rows_shown==5),1,0)">
        <Triggers>
          <Trigger action="up"><IntentCommand
            action="com.toretto5060.pickupcatapp.MAML_PICK"
            package="com.toretto5060.pickupcatapp"
            broadcast="true">
              <Extra name="row_id" type="long" expression="#pc_id1"/>
              <Extra name="row_index" type="string" expression="'1'"/>
            </IntentCommand></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2" w="#btnW" h="#btnH" interceptTouch="true" visibility="ifelse(#page==1 ** (#pc_rows_shown==2 || #pc_rows_shown==3 || #pc_rows_shown==4 || #pc_rows_shown==5),1,0)">
        <Triggers>
          <Trigger action="up"><IntentCommand
            action="com.toretto5060.pickupcatapp.MAML_PICK"
            package="com.toretto5060.pickupcatapp"
            broadcast="true">
              <Extra name="row_id" type="long" expression="#pc_id2"/>
              <Extra name="row_index" type="string" expression="'2'"/>
            </IntentCommand></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2" w="#btnW" h="#btnH" interceptTouch="true" visibility="ifelse(#page==2 ** (#pc_rows_shown==3 || #pc_rows_shown==4 || #pc_rows_shown==5),1,0)">
        <Triggers>
          <Trigger action="up"><IntentCommand
            action="com.toretto5060.pickupcatapp.MAML_PICK"
            package="com.toretto5060.pickupcatapp"
            broadcast="true">
              <Extra name="row_id" type="long" expression="#pc_id3"/>
              <Extra name="row_index" type="string" expression="'3'"/>
            </IntentCommand></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2" w="#btnW" h="#btnH" interceptTouch="true" visibility="ifelse(#page==3 ** (#pc_rows_shown==4 || #pc_rows_shown==5),1,0)">
        <Triggers>
          <Trigger action="up"><IntentCommand
            action="com.toretto5060.pickupcatapp.MAML_PICK"
            package="com.toretto5060.pickupcatapp"
            broadcast="true">
              <Extra name="row_id" type="long" expression="#pc_id4"/>
              <Extra name="row_index" type="string" expression="'4'"/>
            </IntentCommand></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2" w="#btnW" h="#btnH" interceptTouch="true" visibility="ifelse(#page==4 ** (#pc_rows_shown==5),1,0)">
        <Triggers>
          <Trigger action="up"><IntentCommand
            action="com.toretto5060.pickupcatapp.MAML_PICK"
            package="com.toretto5060.pickupcatapp"
            broadcast="true">
              <Extra name="row_id" type="long" expression="#pc_id5"/>
              <Extra name="row_index" type="string" expression="'5'"/>
            </IntentCommand></Trigger>
        </Triggers>
      </Button>
            <Button x="0" y="0" w="#padX+#cardW-#rowPad-#btnW" h="#view_height">
        <Triggers>
          <Trigger action="up"><FunctionCommand target="openApp"/></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad" y="0" w="#padX+#rowPad" h="#view_height">
        <Triggers>
          <Trigger action="up"><FunctionCommand target="openApp"/></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)" w="#btnW" h="(#rowH-#btnH)/2">
        <Triggers>
          <Trigger action="up"><FunctionCommand target="openApp"/></Trigger>
        </Triggers>
      </Button>
      <Button x="#padX+#cardW-#rowPad-#btnW" y="#padTop+#titleH+0*(#rowH+#gap)+(#rowH-#btnH)/2+#btnH" w="#btnW" h="(#rowH-#btnH)/2+#gap">
        <Triggers>
          <Trigger action="up"><FunctionCommand target="openApp"/></Trigger>
        </Triggers>
      </Button>
    </Group>
  </Layer>

  <!-- 数据双通道（变量只在 ContentProviderBinder 声明一次）：
       1) ContentProviderBinder：init 时跨 UID 直查本 App 导出的只读 Provider 拉初始数据，
          因此「重新导入即显示」，不依赖 App 主动推送；并监听 Provider 的 notifyChange 自动重查。
       2) BroadcastBinder：收到 App 推送广播时，用 BinderCommand 触发上面的 CP 重查，
          双保险覆盖新消息/取件后的刷新。不重复声明变量。 -->
  <VariableBinders>
    <ContentProviderBinder name="pc_provider" uri="content://com.toretto5060.pickupcatapp.maml/pending"
        queryAtStart="true" firstRequery="false">
      <Variable name="pc_status" type="string" column="status"/>
      <Variable name="pc_count" type="number" column="count"/>
      <Variable name="pc_rows" type="number" column="rows"/>
      <Variable name="pc_rows_shown" type="number" column="rows_shown"/>
      <Variable name="pc_empty_text" type="string" column="empty_text"/>
      <Variable name="pc_suffix" type="string" column="suffix"/>
      <Variable name="pc_id1" type="number" column="id1"/>
      <Variable name="pc_id2" type="number" column="id2"/>
      <Variable name="pc_id3" type="number" column="id3"/>
      <Variable name="pc_id4" type="number" column="id4"/>
      <Variable name="pc_id5" type="number" column="id5"/>
      <Variable name="pc_company1" type="string" column="company1"/>
      <Variable name="pc_company_color1" type="string" column="company_color1"/>
      <Variable name="pc_code1" type="string" column="code1"/>
      <Variable name="pc_time1" type="string" column="time1"/>
      <Variable name="pc_addr1" type="string" column="addr1"/>
      <Variable name="pc_company2" type="string" column="company2"/>
      <Variable name="pc_company_color2" type="string" column="company_color2"/>
      <Variable name="pc_code2" type="string" column="code2"/>
      <Variable name="pc_time2" type="string" column="time2"/>
      <Variable name="pc_addr2" type="string" column="addr2"/>
      <Variable name="pc_company3" type="string" column="company3"/>
      <Variable name="pc_company_color3" type="string" column="company_color3"/>
      <Variable name="pc_code3" type="string" column="code3"/>
      <Variable name="pc_time3" type="string" column="time3"/>
      <Variable name="pc_addr3" type="string" column="addr3"/>
      <Variable name="pc_company4" type="string" column="company4"/>
      <Variable name="pc_company_color4" type="string" column="company_color4"/>
      <Variable name="pc_code4" type="string" column="code4"/>
      <Variable name="pc_time4" type="string" column="time4"/>
      <Variable name="pc_addr4" type="string" column="addr4"/>
      <Variable name="pc_company5" type="string" column="company5"/>
      <Variable name="pc_company_color5" type="string" column="company_color5"/>
      <Variable name="pc_code5" type="string" column="code5"/>
      <Variable name="pc_time5" type="string" column="time5"/>
      <Variable name="pc_addr5" type="string" column="addr5"/>
    </ContentProviderBinder>
    <BroadcastBinder action="com.toretto5060.pickupcatapp.MAML_WIDGET_CHANGED">
      <Trigger>
        <BinderCommand name="pc_provider"/>
      </Trigger>
    </BroadcastBinder>
  </VariableBinders>

  <!-- 兜底：小部件 init / resume 时主动向 App 要一次最新快照。
       IntentCommand 用 broadcast="true"（不是 type=broadcast），package 让广播显式投递到 App，
       即使 App 进程已被回收，静态注册的 MamlWidgetRequestReceiver 也会被拉起。 -->
  <ExternalCommands>
    <Trigger action="init">
      <IntentCommand action="com.toretto5060.pickupcatapp.MAML_WIDGET_REQUEST"
                     package="com.toretto5060.pickupcatapp" broadcast="true"/>
    </Trigger>
    <Trigger action="resume">
      <IntentCommand action="com.toretto5060.pickupcatapp.MAML_WIDGET_REQUEST"
                     package="com.toretto5060.pickupcatapp" broadcast="true"/>
    </Trigger>
  </ExternalCommands>
</Widget>
