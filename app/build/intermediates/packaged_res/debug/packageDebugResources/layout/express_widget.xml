<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件根布局：保留可上下滑动的 ListView 列表（用户明确要求）。
     android:id="@android:id/background 是小米小部件规范里系统统一裁圆角/叠加桌面材质的固定钩子；
     外层只留淡底色（express_widget_glass_bg）给澎湃 OS4 柔光玻璃，默认模式把 widget_custom_bg
     叠成 VISIBLE 用自绘玻璃盖住，非澎湃 OS4 设备不会裸奔。
     左右 padding 18dp：标题/行字号加大后不会被 24dp 圆角切到。
     widget_list 用 match_parent 填满可见区并保留滚动（不再锁死高度，见 C32）；行内卡片背景由
     express_widget_row_bg 提供，行间靠 ListView 的 dividerHeight 留 8dp 间隙来露出圆角；
     滚动行为保持系统默认，不做任何手势拦截处理（用户确认此前的手势冲突是误报）。
     标题区与列表从顶部开始（无 center_vertical）；paddingTop 取 10dp：既不让标题贴着圆角顶，
     也不会像居中那样把顶部空白放大。paddingBottom 取 16dp：让列表内容离背景底边更远（用户要求）。
     widget_list 用 match_parent 填满可见区并保留滚动，不再锁死高度（否则 HyperOS 报告尺寸≠实际可见区
     会把最后一行永久裁掉，见避坑 C32）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/express_widget_glass_bg">

    <FrameLayout
        android:id="@+id/widget_custom_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/express_widget_bg" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/express_widget_count_red"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title_suffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/express_widget_count_suffix"
                android:textColor="@color/express_widget_title"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="15dp"
            android:scrollbars="none"
            android:overScrollMode="ifContentScrolls"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>
