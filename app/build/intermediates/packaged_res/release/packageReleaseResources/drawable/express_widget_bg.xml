<?xml version="1.0" encoding="utf-8"?>
<!-- 自绘「类磨砂玻璃」：白色半透明基底 + 渐变 + 亮边高光，模拟玻璃质感。
     说明：标准 AppWidget 跑在 App 进程里，无权对桌面壁纸做真正背景模糊（真磨砂只能在澎湃 OS4
     「系统柔光玻璃」模式下由桌面渲染）。自绘模式只能把背景做得更「实」、更少透出壁纸。
     这里不透明度比上一版明显抬高（顶 86% → 底 70% 白），背后内容更不透；
     描边加粗到 1.5dp、提亮，强化玻璃边缘反光。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#DBFFFFFF"
                android:centerColor="#C8FFFFFF"
                android:endColor="#B3FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
