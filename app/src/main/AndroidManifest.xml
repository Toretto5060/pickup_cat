<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性（安装时授予，getInstalledApplications 全量查询的前提） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 国内厂商（MIUI/HyperOS、ColorOS、OriginOS、Harmony 等）在 QUERY_ALL_PACKAGES 之上
         增加的运行时权限：用 requestPermissions 弹系统授权框，拒绝时管控接口返回空列表。
         依据 T/TAF 108-2022 与小米《获取应用列表权限的适配说明》。 -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />
    <!-- 权限异常时向通知中心发提醒（Android 13+ 运行时权限，首次进入请求） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台常驻：申请电池优化白名单 + 开机后重启权限轮询 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 进程守护看门狗用精确闹钟；SCHEDULE_EXACT_ALARM 在 Android 14+ 可能被用户关掉，
         代码里 canScheduleExactAlarms() 检测后回退 setAndAllowWhileIdle，USE_EXACT_ALARM 兜底。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 守护前台服务：Android 14+ 必须声明 foregroundServiceType 与对应权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PickupCat">

        <!-- 首页就是取件码列表 -->
        <activity
            android:name=".app.ExpressListActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PickupCat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.ExpressActivity"
            android:exported="false"
            android:label="@string/settings_title" />
        <activity
            android:name=".app.ExpressRulesActivity"
            android:exported="false"
            android:label="@string/express_rules_title" />
        <activity
            android:name=".app.ExpressAppPickActivity"
            android:exported="false"
            android:label="@string/express_pick_app_title" />

        <!-- 取件码数据：本 App 私有，仅同 UID 可访问 -->
        <provider
            android:name=".express.ExpressProvider"
            android:authorities="${applicationId}.express"
            android:exported="false" />

        <!-- 待取件列表小部件（桌面 + 负一屏）。
             miui.appwidget.action.APPWIDGET_UPDATE 兼容小米桌面的曝光刷新；
             根布局用 @android:id/background 让系统统一裁圆角/叠加桌面材质。 -->
        <receiver
            android:name=".express.ExpressWidgetProvider"
            android:exported="false"
            android:label="@string/express_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/express_widget_info" />
        </receiver>

        <!-- 可上下滑动的待取件列表数据源（仅 Android 11 及以下需要）；BIND_REMOTEVIEWS 保证只有系统桌面能绑定。 -->
        <service
            android:name=".express.ExpressWidgetService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 列表项点击的透明中转页：不进最近任务、不留历史，处理完立即 finish。 -->
        <activity
            android:name=".app.ExpressWidgetClickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 取件码捕获主通道：需用户在系统设置里授予通知使用权，不需要 root / LSPosed -->
        <service
            android:name=".express.ExpressListenService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 双击锁屏：只提供 GLOBAL_ACTION_LOCK_SCREEN，不读取窗口内容。
             需用户在 系统设置 → 无障碍 里启用本服务；设置页开关开启时会引导过去。
             exported=true 供系统绑定，BIND_ACCESSIBILITY_SERVICE 保证第三方无法绑定。 -->
        <service
            android:name=".app.ExpressLockAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/express_lock_accessibility" />
        </service>

        <!-- 进程守护前台服务：specialUse 类型（Android 14+ 要求 property 说明用途） -->
        <service
            android:name=".app.KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="notification_listener_guard" />
        </service>

        <!-- 每 1 分钟看门狗检查监听服务与 4 项权限；开机 / 覆盖安装 / 解锁后重新排程 -->
        <receiver
            android:name=".app.PermissionCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="com.toretto5060.pickupcatapp.PERMISSION_CHECK" />
                <action android:name="com.toretto5060.pickupcatapp.PERMISSION_CHECK_IMMEDIATE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
