<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件行：左列两行（快递 + 取件码 / 时间 + 地址），右列色块「已取」按钮。
     行高恢复固定 58dp（比内容 ~53dp 高 5dp，内容居中不贴卡片边）：不再按桌面报告尺寸动态换算，
     HyperOS 的尺寸回调不可靠（滞后/缓存/只给档位上限），凡依赖它算行高的方案在 5×2↔5×3
     来回 resize 时必然漂移且无法恢复；列表 match_parent + 可滚动，resize 零代码自然适配。
     字号：取件码 26sp、快递公司 16sp、时间/地址 17sp、已取按钮 15sp；
     每行套纯白实心圆角卡片 express_widget_row_bg（用户要白色背景、不要浅灰），行间靠 ListView
     dividerHeight 留小间隙分隔；左右 padding 14dp 让文字/按钮不贴两侧；文字全部单行省略。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:background="@drawable/express_widget_row_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/row_company"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:textColor="@color/express_widget_pick_bg"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/row_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:textColor="@color/express_widget_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="0dp">

            <TextView
                android:id="@+id/row_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/express_widget_secondary"
                android:textSize="17sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/row_addr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:textColor="@color/express_widget_secondary"
                android:textSize="17sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- RemoteViews 不支持 style，用带圆角色块背景的 TextView 当按钮 -->
    <TextView
        android:id="@+id/row_pick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/express_widget_pick_bg"
        android:text="@string/express_picked"
        android:textColor="@color/express_widget_pick_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:minHeight="42dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />
</LinearLayout>
